{
  "name": "web-development-learning",
  "private": true,
  "version": "1.1.0",
  "description": "Web 开发学习宝典：从前端走向全栈与 AI 应用开发，连接原理、实践、自测与复盘。",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vitepress dev src",
    "build": "cross-env NODE_ENV=production vitepress build src",
    "preview": "cross-env NODE_ENV=production vitepress preview src",
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release",
    "lint": "eslint src/.vitepress src/templates scripts eslint.config.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test scripts/__tests__/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "viewerjs": "1.15.2",
    "vitepress-plugin-image-viewer": "1.1.6",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "markdown-it-mathjax3": "4.3.2",
    "postcss": "8.5.32",
    "standard-version": "9.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitepress": "1.6.4",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.14.0 <13"
  }
}
