{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/.vitepress/theme/**/*.ts", "src/.vitepress/theme/**/*.vue", "src/.vitepress/data/**/*.ts", "src/templates/**/*.vue", "src/env.d.ts"]
}
